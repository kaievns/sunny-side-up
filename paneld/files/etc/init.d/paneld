#!/bin/sh /etc/rc.common
# procd init script for paneld - the per-node panel daemon.
# Config lives in /etc/config/paneld (UCI). Manage with:
#   service paneld enable
#   service paneld start | stop | restart | status

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/paneld

start_service() {
	config_load paneld

	local enabled role name ip iface wifiiface ping hosts rotate interval
	local board bl clock fan_on fan_off fan_max
	local dhcp wifi fan invert bgr

	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || return 0

	config_get role      main role      gateway
	config_get name      main name      node
	config_get ip        main ip        ""
	config_get iface     main iface     ""
	config_get wifiiface main wifiiface ""
	config_get ping      main ping      ""
	config_get hosts     main hosts     ""
	config_get rotate    main rotate    90
	config_get interval  main interval  2s
	config_get fan_on    main fan_on    65
	config_get fan_off   main fan_off   55
	config_get fan_max   main fan_max   75
	config_get board     main board     v1
	config_get bl        main bl        200
	config_get clock     main clock     15000000
	config_get_bool dhcp   main dhcp   0
	config_get_bool wifi   main wifi   0
	config_get_bool fan    main fan    0
	config_get_bool invert main invert 0
	config_get_bool bgr    main bgr    0

	procd_open_instance
	procd_set_param command "$PROG" \
		-role "$role" -name "$name" -ip "$ip" \
		-iface "$iface" -wifiiface "$wifiiface" -ping "$ping" \
		-rotate "$rotate" -interval "$interval" \
		-fan-on "$fan_on" -fan-off "$fan_off" -fan-max "$fan_max" \
		-board "$board" -bl "$bl" -clock "$clock"
	[ "$dhcp" = "1" ]   && procd_append_param command -dhcp
	[ "$wifi" = "1" ]   && procd_append_param command -wifi
	[ "$fan" = "1" ]    && procd_append_param command -fan
	[ "$invert" = "1" ] && procd_append_param command -invert
	[ "$bgr" = "1" ]    && procd_append_param command -bgr
	[ -n "$hosts" ]     && procd_append_param command -hosts "$hosts"

	# Restart if it exits (e.g. board unplugged and paneld gives up); throttle
	# restarts so a persistent failure doesn't spin.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger paneld
}

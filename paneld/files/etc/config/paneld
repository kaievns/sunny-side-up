# paneld per-node config. Edit for this node, then: service paneld restart
#
# role      gateway | extender | homelab
# name      location shown top-left (e.g. 'kitchen', 'living room')
# ip        node IP shown top-left
# iface     interface for throughput (WAN for gateway, uplink for nodes)
# wifiiface wifi interface(s) for client counts, comma-separated for multi-BSS
#           nodes (e.g. 'phy1-ap0,phy0-ap0,phy0-ap1'); blank if none
# ping      latency target (public IP for gateway; the gateway IP for nodes)
# hosts     homelab: comma-separated hosts to health-check (e.g. 'nas,cam-02')
# rotate    panel rotation: 90 or 270 (whichever is upright in your enclosure)
# dhcp/wifi/fan/invert/bgr  1 to enable, 0 to disable
# board     v1 (GPIO fan gate, on/off fan) | v2 (ATtiny fan PWM + backlight)
# bl        v2 backlight brightness 0-255
# clock     SPI clock in Hz. 15000000 when the USB cabling is clean; drop to
#           6000000 if the screen corrupts under SoC load (marginal cables
#           lose SPI margin when the router is busy - the ATtiny link's CRC
#           rides it out, the LCD can't)
# fan_on: fan on at/above this °C; fan_off: off below this °C (hysteresis).
# v2 boards run a duty curve between them: calibrated floor at fan_on,
# full speed at fan_max. v1 fans are on/off only (chopping stalls them).

config paneld 'main'
	option enabled '1'
	option role 'gateway'
	option name 'kitchen'
	option ip '10.0.0.1'
	option iface 'eth1'
	option wifiiface ''
	option ping '1.1.1.1'
	option hosts ''
	option rotate '90'
	option interval '2s'
	option dhcp '1'
	option wifi '1'
	option fan '1'
	option invert '0'
	option bgr '0'
	option fan_on '65'
	option fan_off '55'
	option fan_max '75'
	option board 'v1'
	option bl '200'
